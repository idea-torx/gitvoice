{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitvoice",
  // Leave empty to fall back to the CLOUDFLARE_ACCOUNT_ID environment variable,
  // or fill in your own account id.
  "account_id": "",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitvoice",
      // Run `npx wrangler d1 create gitvoice` and paste the returned id here.
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "INVOICE_PDFS",
      "bucket_name": "gitvoice-pdfs"
    }
  ],
  "triggers": {
    "crons": ["0 8 * * *"]
  },
  "vars": {
    "APP_ORIGIN": "https://your-worker.example.workers.dev",
    "OPENAI_MODEL": "gpt-5.6-luna"
  }
}
